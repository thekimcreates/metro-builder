{
  "schemaVersion": 1,
  "id": "curvify",
  "version": "${version}",
  "name": "Curvify",
  "description": "Curved platform screen door placement using Minecraft Transit Railway's built-in PSD blocks.",
  "authors": [
    "thekimcreates"
  ],
  "license": "MIT",
  "icon": "assets/curvify/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.thekimcreates.curvify.Curvify"
    ],
    "client": [
      "dev.thekimcreates.curvify.CurvifyClient"
    ]
  },
  "mixins": [
    "curvify.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.17.2",
    "minecraft": "~1.20.4",
    "java": ">=17",
    "fabric-api": "*",
    "mtr": ">=4.0.5"
  }
}
